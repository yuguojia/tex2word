@article{karQuantitativeAnalysisHysteresis2006,
  title = {Quantitative Analysis of Hysteresis in Carbon Nanotube Field-Effect Devices},
  author = {Kar, Swastik and Vijayaraghavan, Aravind and Soldano, Caterina and Talapatra, Saikat and Vajtai, Robert and Nalamasu, Omkaram and Ajayan, Pulickel M.},
  date = {2006-09-25},
  journaltitle = {Applied Physics Letters},
  shortjournal = {Appl. Phys. Lett.},
  volume = {89},
  number = {13},
  pages = {132118},
  issn = {0003-6951, 1077-3118},
  doi = {10.1063/1.2358290},
  url = {https://pubs.aip.org/apl/article/89/13/132118/326524/Quantitative-analysis-of-hysteresis-in-carbon},
  urldate = {2025-09-08},
  abstract = {The authors present a model to analyze hysteresis in transfer characteristics (TCs) of single-wall carbon nanotube field-effect transistors, based on capacitive charging of the surrounding dielectric by charges injected out of the nanotube. The model identifies the extent and time scale of the hysteresis and correctly describes the dependence of the magnitude of hysteresis on common experimental parameters. The authors propose and experimentally establish a “time-decay” experiment for obtaining accurate device properties in hysteresis-affected devices without actually measuring TCs. The authors further show that values obtained by this method can be used to precisely predict TCs for the same device under different experimental parameters.},
