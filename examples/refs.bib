}

@article{liangEvidencePseudocapacitanceFaradaic2020,
  title = {Evidence for Pseudocapacitance and Faradaic Charge Transfer in High-Mobility Thin-Film Transistors with Solution-Processed Oxide Dielectrics},
  author = {Liang, Xiaoci and Liu, Ling and Cai, Guangshuo and Yang, Peng and Pei, Yanli and Liu, Chuan},
  date = {2020-04-02},
  journaltitle = {Journal of Physical Chemistry Letters},
  shortjournal = {J. Phys. Chem. Lett.},
  volume = {11},
  number = {7},
  pages = {2765--2771},
  issn = {1948-7185, 1948-7185},
  doi = {10.1021/acs.jpclett.0c00583},
  url = {https://pubs.acs.org/doi/10.1021/acs.jpclett.0c00583},
  urldate = {2026-01-09},
  abstract = {In developing low-power electronics, low-voltage transistors have been intensively investigated. One of the most important findings is that some high-k oxide gate dielectrics can lead to remarkable enhancement of apparent mobility in thin-film transistors (TFTs), which is not clearly understood. Here, we investigate InOx TFTs with solution-processed AlOx dielectrics. At very low frequencies ({$<$}1 Hz), the AlOx films feature strong voltage-dependent capacitance. Also, cyclic voltammograms show clear features of surface-controlled Faradaic charge transfer. The two independent experiments both point to the formation of pseudocapacitance, which is similar to the mechanism behind some supercapacitors. A physical model including charge transfer is established to describe ion distribution. The charge transfer is probably related to residual hydrogens, as revealed by secondary-ion mass spectroscopy. The results provide direct evidence of the formation of pseudocapacitance in TFTs with high apparent mobilities and advance the understanding of mechanisms, measurements, and applications of such TFTs for low-power electronics.},
  langid = {english},
  annotation = {titleTranslation: 具有溶液处理氧化物电介质的高迁移率薄膜晶体管中赝电容和法拉第电荷转移的证据},
  file = {C:\Users\余国佳\Zotero\storage\9HKZDKR6\Liang 等 - 2020 - Evidence for Pseudocapacitance and Faradaic Charge Transfer in High-Mobility Thin-Film Transistors w.pdf}
}

