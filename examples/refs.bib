@article{wangFlexibleTransparentConductive2025,
  title = {Flexible, Transparent and Conductive Silver Line Electrodes Fabricated Using Surface Energy-Directed Assembly Process on Polyethylene Naphthalate Substrates},
  author = {Wang, Yihuan and Yuan, Siqing and Wang, Guangji and Fan, Zebin and Zhang, Jingwei and Li, Zetong and Liu, Chenhua and Zhao, Dewen and Chai, Zhimin and Lu, Xinchun},
  date = {2025-04},
  journaltitle = {Chemical Engineering Journal},
  shortjournal = {Chem. Eng. J.},
  volume = {509},
  pages = {161172},
  issn = {13858947},
  doi = {10.1016/j.cej.2025.161172},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S138589472501993X},
  urldate = {2026-01-09},
  abstract = {Flexible transparent conductive electrodes (FTCEs) are essential components in emerging optoelectronics, including flexible displays, smart glasses/windows, organic solar cells, and electronic skins. The surface energydirected assembly (SEDA) process, known for its capability to create high-resolution and high-fidelity patterns, has been utilized to fabricate TCEs on rigid glass substrates. However, the fabrication of FTCEs on flexible substrates remains comparatively underexplored. Here, we present the fabrication of silver patterns on polyethylene naphthalate (PEN) substrates using the SEDA process. A surface treatment process has been devised to render the PEN substrates hydrophobic, achieved through coating the substrates with fluorine-containing PyFlon films. This approach yields a significant improvement over silane-based self-assembled monolayer film-coated substrates, as it drastically diminishes surface roughness. Consequently, the contact angle hysteresis of the substrate surface is minimized, enabling the effective dewetting of the nanoparticle suspension. The incorporation of PyFlon films into the SEDA process has proven to be highly successful. Using this approach, we have successfully assembled functional patterns of various geometries and dimensions on PEN substrates, composed of silver nanoparticles, quantum dots, carbon nanotubes, silver nanowires, and gallium indium eutectic, with a high resolution down to 500 nm. The assembled silver line electrodes exhibit excellent transmittance (\textasciitilde 88\%), low sheet resistance (7.12 Ω/□), and high mechanical stability, and their application in electroluminescent devices is showcased.},
  langid = {english},
  annotation = {titleTranslation: 采用表面能定向组装工艺在聚萘二甲酸乙二醇酯基底上制造柔性、透明和导电的银线电极},
  file = {C\:\\Users\\余国佳\\Zotero\\storage\\HGNF2JQH\\1-s2.0-S138589472501993X-mmc1.docx;C\:\\Users\\余国佳\\Zotero\\storage\\QINRMVF2\\Wang 等 - 2025 - Flexible, transparent and conductive silver line electrodes fabricated using surface energy-directed.pdf}
}
